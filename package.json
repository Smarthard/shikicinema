{
  "name": "shikicinema",
  "version": "0.9.21",
  "description": "Returns video player on Shikimori",
  "main": "src/shikicinema.js",
  "engines": {
    "node": ">=18"
  },
  "private": true,
  "keywords": [
    "extension",
    "shikimori"
  ],
  "author": "Smarthard",
  "license": "BSD-2-Clause",
  "bugs": {
    "url": "https://github.com/Smarthard/shikicinema/issues"
  },
  "homepage": "https://github.com/Smarthard/shikicinema",
  "repository": {
    "type": "git",
    "url": "https://github.com/Smarthard/shikicinema.git"
  },
  "scripts": {
    "ng": "ng",
    "cap": "cap",
    "tsx": "tsx",
    "npx": "npx",
    "ionic": "ionic",
    "start": "ionic serve",
    "start:native": "npm-run-all -s 'ionic cap sync' 'npx cap sync @capacitor-community/electron' 'npx cap open @capacitor-community/electron'",
    "build": "ionic build --c=development",
    "build:prod": "ionic build --c=production",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "ng lint",
    "commit-lint": "ng lint --max-warnings 0",
    "e2e": "ng e2e",
    "set-env": "tsx setup-env.ts",
    "watch": "ionic build --watch --configuration development",
    "analyze-bundle": "ng build -c production --stats-json"
  },
  "workspaces": [
    "electron"
  ],
  "pre-commit": [
    "commit-lint"
  ],
  "dependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@capacitor-community/electron": "^5.0.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/status-bar": "^8.0.3",
    "@ionic/angular": "^9.0.1",
    "@ionic/core": "^9.0.1",
    "@ionic/storage-angular": "^4.0.0",
    "@jsverse/transloco": "^8.4.0",
    "@ngrx/effects": "^22.0.0",
    "@ngrx/operators": "^22.0.0",
    "@ngrx/store": "^22.0.0",
    "date-fns": "^4.4.0",
    "deep-object-diff": "^1.1.9",
    "intl-messageformat": "^11.2.14",
    "ionicons": "^8.1.0",
    "ngrx-store-localstorage": "^20.1.0",
    "ngx-scrollbar": "^19.1.5",
    "ngx-tippy-wrapper": "^6.3.0",
    "ngxtension": "^7.3.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.0.0",
    "@angular-eslint/eslint-plugin": "^22.0.0",
    "@angular-eslint/eslint-plugin-template": "^22.0.0",
    "@angular-eslint/schematics": "^22.0.0",
    "@angular-eslint/template-parser": "^22.0.0",
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@angular/language-service": "^22.0.0",
    "@capacitor/cli": "^8.5.0",
    "@fastify/pre-commit": "^2.2.1",
    "@ionic/angular-toolkit": "^13.0.0",
    "@ionic/cli": "^7.2.1",
    "@ngrx/eslint-plugin": "^22.0.0",
    "@ngrx/schematics": "^22.0.0",
    "@ngrx/store-devtools": "^22.0.0",
    "@puppeteer/ng-schematics": "^0.7.0",
    "@types/chrome": "^0.0.258",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "babel-loader": "^9.1.3",
    "chrome-webstore-upload-cli": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "dotenv": "^16.3.2",
    "eslint": "^9.0.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.5.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-sort-imports-es6-autofix": "^0.6.0",
    "eslint-webpack-plugin": "^5.0.2",
    "jsdom": "^29.1.1",
    "ngxtension-plugin": "^7.1.0",
    "npm-run-all": "^4.1.5",
    "puppeteer": "24.9.0",
    "terser-webpack-plugin": "^5.3.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^6.0.0",
    "vitest": "^4.1.8",
    "web-ext": "^10.1.0",
    "webpack": "^5.89.0"
  }
